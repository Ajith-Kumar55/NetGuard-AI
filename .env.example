DATABASE_URL=sqlite:///./netguard.db

# Security Requirement: Must be changed to a strong, randomly generated secret key in production
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security: Allowed origin URLs separated by commas (e.g. http://127.0.0.1:8080)
CORS_ORIGINS=http://127.0.0.1:8080

UPLOAD_MAX_SIZE_MB=50
